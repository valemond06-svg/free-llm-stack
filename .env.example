# Copia in .env (che è in .gitignore) e compila. Non committare MAI .env.
# Genera i segreti con:  openssl rand -hex 32
# (Windows PowerShell:   -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) }) )

# ---- FreeLLMAPI ----
# Obbligatoria. Cifra le API key dei provider nel DB. Se la perdi, le key salvate
# non si decifrano più: salvala in un password manager.
ENCRYPTION_KEY=
FREELLMAPI_PORT=3001
# FREELLMAPI_VERSION=latest
# HOST_BIND=127.0.0.1          # lascia così. 0.0.0.0 solo su LAN fidata.

# Config dichiarativa opzionale (key dei provider + account admin al primo avvio).
# Crea secrets/freellmapi.config.json partendo da config/freellmapi.config.example.json
# FREEAPI_CONFIG_PATH=/secrets/freellmapi.config.json

# ---- Antigravity (opzionale, profilo docker "antigravity") ----
ANTIGRAVITY_PROXY_API_KEY=
ANTIGRAVITY_WEBUI_PASSWORD=
BRIDGE_API_KEY=
# ANTIGRAVITY_PROXY_PORT=8080
# Solo se usi frieser/antigravity-proxy (API OpenAI, niente bridge): lo controlla scripts/doctor.py
# ANTIGRAVITY_OPENAI_URL=http://127.0.0.1:3000
# BRIDGE_PORT=3005
